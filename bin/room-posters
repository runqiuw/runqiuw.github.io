#!/usr/bin/env bash
# Real-time day/night captures wait for GPU preparation and image artwork; then update OG.
# Build and serve dist first; URL and CHROME can override the local preview / browser.
set -euo pipefail
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
node "$SCRIPT_DIR/room-posters.mjs"
node "$SCRIPT_DIR/room-og.mjs"
