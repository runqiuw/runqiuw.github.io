#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly OUT_DIR="$REPO_ROOT/public/room/assets"
readonly BLENDER="${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}"
# The asset library lives outside the repo; its path comes from $ROOM_ASSETS or from
# bin/.room-assets-path (one line, not committed).
LIBRARY="${ROOM_ASSETS:-$(cat "$SCRIPT_DIR/.room-assets-path" 2>/dev/null || true)}"

usage() {
  cat <<'EOF'
Usage: bin/room-assets [--watch]

Export every asset_* collection in room_assets.blend to
public/room/assets/<name>.glb (meshopt-compressed) and write
public/room/assets/manifest.json.

Options:
  --watch  Keep running and re-export whenever the .blend is saved.

Environment:
  ROOM_ASSETS  Path to the asset library .blend (default: the path in bin/.room-assets-path)
  BLENDER      Blender executable (default: /Applications/Blender.app/...)
EOF
}

export_once() {
  "$BLENDER" -b "$LIBRARY" --python "$SCRIPT_DIR/room_assets_export.py" -- "$OUT_DIR" 2>&1 \
    | grep -vE '^(Blender |ArchWarn| Function| +File| +Line|Writing:|BlenderMCP|$)|INFO|Info:|Read blend' || true
  compress
}

# Meshopt-compress every GLB in place (about 5x smaller; the site decodes it with
# three's MeshoptDecoder) and record the compressed sizes in manifest.json.
compress() {
  local glb
  for glb in "$OUT_DIR"/*.glb; do
    "$REPO_ROOT/node_modules/.bin/gltf-transform" meshopt "$glb" "$glb" >/dev/null
  done
  node -e '
    const fs = require("fs"), path = require("path"), dir = process.argv[1];
    const file = path.join(dir, "manifest.json"), m = JSON.parse(fs.readFileSync(file, "utf8"));
    let total = 0;
    for (const a of Object.values(m.assets)) total += a.bytes = fs.statSync(path.join(dir, a.file)).size;
    fs.writeFileSync(file, JSON.stringify(m, null, 2) + "\n");
    console.log(`compressed: ${(total / 1024 / 1024).toFixed(2)} MB total`);
  ' "$OUT_DIR"
}

if [[ "${1:-}" != -h && "${1:-}" != --help && ! -f "$LIBRARY" ]]; then
  echo "Asset library not found. Set ROOM_ASSETS or put its path in bin/.room-assets-path." >&2
  exit 1
fi

case "${1:-}" in
  -h|--help) usage ;;
  --watch)
    export_once
    last="$(stat -f %m "$LIBRARY")"
    echo "Watching $LIBRARY (Ctrl-C to stop)"
    while sleep 2; do
      now="$(stat -f %m "$LIBRARY")"
      if [[ "$now" != "$last" ]]; then
        last="$now"
        echo "--- $(date +%H:%M:%S) saved, exporting"
        export_once
      fi
    done
    ;;
  "") export_once ;;
  *) usage >&2; exit 2 ;;
esac
