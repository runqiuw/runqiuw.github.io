---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';

const previews = import.meta.glob<{ default: ImageMetadata }>('../assets/img/papers/*', { eager: true });
const preview = (name?: string) => (name ? previews[`../assets/img/papers/${name}`]?.default : undefined);

const papers = (await getCollection('papers')).sort((a, b) => b.data.year - a.data.year || (b.data.month ?? 0) - (a.data.month ?? 0));
const ME = 'Runqiu Wang';
const venueLabel = (s: string) => s.replace(/'(\d\d)/, '’$1');
// What the room's monitors show while a paper is in view (read by src/scripts/room.ts).
const screenImg = async (img?: ImageMetadata) => (img ? (await getImage({ src: img, width: 640, format: 'webp' })).src : undefined);
const screens = Object.fromEntries(await Promise.all(papers.map(async ({ id, data: p }) => [id, await screenImg(preview(p.preview))])));
---

<section id="research" data-section="research" class="block">
  <p class="kicker">On the desk</p>
  <h2>Research</h2>
  <p class="muted lede">
    Applied machine learning and computer vision for ubiquitous and ambient sensing, tying the physical and digital worlds
    together.
  </p>
  <ol class="papers">
    {
      papers.map(({ id, data: p }) => {
        const img = preview(p.preview);
        const main = p.website ?? (p.doi ? `https://doi.org/${p.doi}` : p.pdf);
        const links = [
          ['Project page', p.website],
          ['PDF', p.pdf],
          ['Code', p.code],
          ['Video', p.video],
          ['Talk', p.talk],
          ['Appendix', p.appendix],
          ['DOI', p.doi && `https://doi.org/${p.doi}`],
        ].filter(([, h]) => h) as [string, string][];
        return (
          <li
            class="paper"
            data-item={id}
            data-screen-title={p.title}
            data-screen-venue={venueLabel(p.series) || String(p.year)}
            data-screen-img={screens[id]}
            data-screen-video={p.teaser}
          >
            {img ? <Image src={img} alt="" widths={[160, 320]} sizes="160px" /> : <div class="ph" />}
            <div>
              <span class="venue">{venueLabel(p.series) || p.year}</span>
              <h3>{main ? <a href={main}>{p.title}</a> : p.title}</h3>
              <p class="authors">
                {p.authors.map((a, i) => (
                  <>
                    {a === ME ? <strong>{a}</strong> : a}
                    {p.equal.includes(a) && <sup title="Equal contribution">*</sup>}
                    {i < p.authors.length - 1 ? ', ' : ''}
                  </>
                ))}
              </p>
              <p class="where">
                {p.venue}
                {p.location ? `, ${p.location}` : ''}
                {p.equal.length > 0 && <span> · * equal contribution</span>}
              </p>
              <ul class="plinks">
                {links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .lede {
    max-width: 60ch;
    margin: 8px 0 18px;
  }
  .papers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .paper {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr);
    gap: 18px;
    padding: 14px;
    border-radius: 22px;
    transition: background 0.25s, box-shadow 0.25s, translate 0.35s var(--spring);
  }
  .paper:hover,
  .paper:focus-within {
    background: var(--surface);
    box-shadow: var(--clay);
    translate: 0 -2px;
  }
  .paper :global(img),
  .ph {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 14px;
    background: var(--bg-2);
  }
  .venue {
    font: 600 12px var(--font-display);
    background: var(--blue);
    color: var(--on-blue);
    border-radius: 999px;
    padding: 2px 10px;
    display: inline-block;
  }
  h3 {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 17px;
    line-height: 1.35;
    margin: 7px 0 4px;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .authors,
  .where {
    margin: 0;
    font-size: 14px;
    color: var(--mute);
    line-height: 1.45;
  }
  .authors strong {
    color: var(--ink);
  }
  .where {
    font-size: 13px;
    margin-top: 2px;
  }
  .plinks {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font: 600 13px var(--font-display);
  }
  .plinks a {
    color: var(--link);
    text-decoration: none;
  }
  .plinks a:hover {
    text-decoration: underline;
  }
  @media (max-width: 520px) {
    .paper {
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 12px;
      padding: 10px;
    }
  }
</style>
