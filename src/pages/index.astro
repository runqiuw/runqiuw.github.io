---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RoomPanel from '../components/RoomPanel.astro';
import Intro from '../components/Intro.astro';
import Papers from '../components/Papers.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GameCard from '../components/GameCard.astro';
import Pinboard from '../components/Pinboard.astro';
import { profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
---

<Base home>
  <div class="split">
    <RoomPanel />
    <main id="main" class="content">
      <Intro />
      <Papers />
      <Section id="projects" kicker="On the shelf" title="Projects">
        <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
      </Section>
      <Section id="games" kicker="In the game corner" title="Games" lede="Games I’ve made with Unity. All three run in your browser on itch.io.">
        <div class="grid">{games.map((g) => <GameCard game={g} />)}</div>
      </Section>
      <Section id="playground" kicker="On the wall" title="Playground" lede="Things I like, pinned to the wall above my desk.">
        <Pinboard />
      </Section>
      <Section id="contact" kicker="By the door" title="Say hi">
        <p class="mail">{profile.email}</p>
        <p class="muted">{profile.location}. Happy to chat about sensing, machine learning, or games.</p>
        <div class="links">
          <a class="pill" href={profile.links.scholar}>Google Scholar</a>
          <a class="pill" href={profile.links.github}>GitHub</a>
          <a class="pill" href={profile.links.orcid}>ORCID</a>
          <a class="pill" href={profile.links.itch}>itch.io</a>
        </div>
      </Section>
    </main>
  </div>
</Base>

<script>
  // Track which section is in the middle of the viewport: highlight the nav link and tell
  // the room panel (and, later, the 3D room) via a `sectionchange` event.
  let current = '';
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  const setSection = (id: string) => {
    if (id === current) return;
    current = id;
    document.documentElement.dataset.section = id;
    links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.sectionLink === id)));
    window.dispatchEvent(new CustomEvent('sectionchange', { detail: id }));
  };
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting && !atEnd()) setSection((e.target as HTMLElement).dataset.section!);
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  sections.forEach((s) => io.observe(s));
  // A short last section never reaches the middle of the viewport; at the end of the page it wins.
  const atEnd = () => innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
  addEventListener('scroll', () => atEnd() && setSection(sections[sections.length - 1].dataset.section!), { passive: true });

  // Same idea one level down: the item (paper, project, game…) in the middle of the viewport is the
  // one the room shows. Hovering or focusing another item shows that one until the pointer leaves.
  let scrolled = '';
  const showItem = (id: string) => {
    if (id === document.documentElement.dataset.item) return;
    document.documentElement.dataset.item = id;
    window.dispatchEvent(new CustomEvent('itemchange', { detail: id }));
  };
  const items = document.querySelectorAll<HTMLElement>('[data-item]');
  const itemIo = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) showItem((scrolled = (e.target as HTMLElement).dataset.item!));
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  items.forEach((el) => {
    itemIo.observe(el);
    const pick = () => showItem(el.dataset.item!);
    const back = () => scrolled && showItem(scrolled);
    el.addEventListener('pointerenter', pick);
    el.addEventListener('pointerleave', back);
    el.addEventListener('focusin', pick);
    el.addEventListener('focusout', back);
  });
</script>

<style>
  .split {
    display: grid;
    grid-template-columns: 42% minmax(0, 1fr);
  }
  .content {
    padding: 8px clamp(20px, 4vw, 64px) 60px;
    min-width: 0;
    max-width: 820px;
  }
  .content :global(.block) {
    padding-block: 40px;
  }
  .content :global(h2) {
    font-size: var(--step-3);
    margin-top: 6px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 18px;
  }
  .mail {
    font: 600 var(--step-2) var(--font-display);
    margin: 14px 0 4px;
    word-break: break-all;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .split > :global(.room) {
      display: none;
    }
  }
</style>
