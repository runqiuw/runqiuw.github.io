---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects" description="Projects by Runqiu Wang: sensing, machine learning, mixed reality, and mechanical engineering.">
  <main id="main" class="page">
    <p class="kicker">In the cart</p>
    <h1>Projects</h1>
    <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
  </main>
</Base>

<style>
  .page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 20px 60px;
  }
  h1 {
    font-size: var(--step-4);
    margin: 6px 0 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
  }
</style>
